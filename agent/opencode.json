// opencode.json - JAI agent config (OpenCode v2 format, verified on 2.2.0)
//
// v2 schema facts (binary-verified, see docs/DECISIONS.md):
//   permissions is an ARRAY of {action, resource, effect}; action is "shell"
//   mcp.servers.<name>.disabled  (NOT v1's mcp.<name>.enabled)
//
// Brain (2026-11-02, live-VM verified): OpenCode Zen free model
// "opencode/mimo-v2.6-flash-free" via DEVICE-FLOW login. Field findings
// that are now policy (docs/NEXT-STEPS.md 5e-3):
//   - v2.2.0 keeps credentials in ~/.local/share/opencode/opencode*.db
//     (SQLite). There is NO auth.json in v2 - "Connected" + no file is
//     expected, not an error.
//   - service-account API keys carry NO free quota (auth succeeds, first
//     call returns "Free usage limit reached"). Use the personal
//     console account via `opencode auth login` -> device flow.
//   - autoupdate=false: the appliance pins its brain. Upgrades are a
//     deliberate act (scripts/vm-upgrade-brain.sh: db backup -> upgrade
//     -> smoke test). The v1->v2 schema drift already broke configs once;
//     unattended self-updates on a headless appliance are unattended
//     breakage.
// The openrouter provider block below stays as a FALLBACK catalog
// (limit.output 4096 sidesteps the OpenRouter credit pre-flight on $0).
// Per-call model override: JAI_MODEL=<provider/model> jai "..."
// Discover candidates: opencode models | grep free
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/etc/jai/IDENTITY.md"
  ],
  "model": "opencode/mimo-v2.6-flash-free",
  "autoupdate": false,
  "mcp": {
    "servers": {
      "jai-mcp": {
        "type": "local",
        "command": ["/usr/bin/jai-mcp"],
        "disabled": false
      },
      "jai-system": {
        "type": "local",
        "command": ["python3", "/usr/local/jai/mcp/jai-system.py"],
        "disabled": true
      }
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (free)",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 4096 }
        },
        "google/gemma-4-31b-it:free": {
          "name": "Gemma 4 31B (free, fast)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 4096 }
        },
        "cohere/north-mini-code:free": {
          "name": "North Mini Code (free, coder)",
          "tool_call": true,
          "limit": { "context": 256000, "output": 4096 }
        }
      }
    }
  },
  "permissions": [
    { "action": "edit",  "resource": "*",                       "effect": "ask" },
    { "action": "shell", "resource": "*",                       "effect": "ask" },
    { "action": "shell", "resource": "cat /dev/jai*",           "effect": "allow" },
    { "action": "shell", "resource": "echo * | tee /dev/jai*",  "effect": "allow" },
    { "action": "shell", "resource": "systemctl status jai-*",  "effect": "allow" },
    { "action": "shell", "resource": "sudo -n /usr/bin/systemctl restart jai-*", "effect": "allow" }
  ]
}
